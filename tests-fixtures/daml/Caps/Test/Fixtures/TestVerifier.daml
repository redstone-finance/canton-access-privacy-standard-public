-- | A verifier for tests, free of cryptography. A payload is authentic when
-- it is the text `acceptedTag`; the round commitment is a SHA-256 over the
-- data point's fixing time and values; a round attestation is a SHA-256
-- over one of `attestationKeys`, shared secrets standing in for signing
-- keys, the round number and the commitment, which carries the fixing time;
-- a fixing time is fresh within `maxBehind` and `maxAhead` of the reference
-- time. Enough to exercise every path of the reference implementation
-- without a signing scheme.
module Caps.Test.Fixtures.TestVerifier where

import DA.Optional (isNone)
import DA.Text (sha256)
import DA.Time (RelTime, addRelTime)

import qualified Caps.Api.CoreV1 as Api
import DataStandard.DataPointV1 (PublishedDataPointView)
import DataStandard.Utils (AnyValue(..))

template TestVerifier
  with
    owner : Party
    acceptedTag : Text
    attestationKeys : [Text]
      -- ^ Secrets a round attestation may be computed with; empty for none.
      -- A key attests the rounds of one definition only.
    observers : [Party]
      -- ^ For the canonical instance, the readers: a publication exercises
      -- the verifier, and a contract used in a transaction must be visible
      -- to the submitter. A consumer's own instance needs none.
    maxBehind : RelTime
      -- ^ How far behind the reference time a fixing time may be.
    maxAhead : RelTime
      -- ^ How far ahead of the reference time a fixing time may be.
  where
    signatory owner
    observer observers

    interface instance Api.Verifier for TestVerifier where
      view = Api.VerifierView {}

      verifier_verifyImpl _self arg = pure $ verdict (testCommitment arg.capsule.content.dataPoint)
        [ ("payload is not authentic", arg.capsule.content.payload == AVText acceptedTag) ]

      verifier_verifyRoundImpl _self arg = pure $ outcome $
        [ ("round belongs to another definition", arg.round.definition == arg.capsule.definition)
        , ("round number mismatch", arg.round.roundNumber == arg.capsule.roundNumber)
        , ("round timestamp differs from the fixing time", arg.round.timestamp == arg.capsule.content.dataPoint.publishedAt)
        , ("commitment mismatch", arg.round.dataHash == testCommitment arg.capsule.content.dataPoint)
        ] <> attestationChecks attestationKeys arg.round

      verifier_verifyFreshnessImpl _self arg =
        let fixingTime = arg.capsule.content.dataPoint.publishedAt
        in pure $ outcome
          [ ("fixing time too far in the past", fixingTime >= addRelTime arg.asOf (negate maxBehind))
          , ("fixing time too far in the future", fixingTime <= addRelTime arg.asOf maxAhead)
          ]

-- | The reasons of the failed checks, in order.
failures : [(Api.RejectionReason, Bool)] -> [Api.RejectionReason]
failures checks = [ reason | (reason, ok) <- checks, not ok ]

-- | `Verified` with the commitment when every check holds, otherwise the
-- reasons of the failed ones.
verdict : Text -> [(Api.RejectionReason, Bool)] -> Api.VerificationResult
verdict dataHash checks = case failures checks of
  [] -> Api.Verified dataHash
  failed -> Api.Rejected failed

-- | `Passed` when every check holds, otherwise the reasons of the failed ones.
outcome : [(Api.RejectionReason, Bool)] -> Api.CheckResult
outcome checks = case failures checks of
  [] -> Api.Passed
  failed -> Api.Failed failed

-- | The test verifier's round commitment.
testCommitment : PublishedDataPointView -> Text
testCommitment dp = sha256 (show dp.publishedAt <> "|" <> show dp.values)

-- | The test verifier's round attestation: what the key holder of `key`
-- attaches to `round`.
testAttestation : Text -> Api.RoundView -> Text
testAttestation key Api.RoundView{roundNumber, dataHash} =
  sha256 (key <> "|" <> show roundNumber <> "|" <> dataHash)

-- | The attestation checks: the round must carry none when the verifier
-- names no keys, otherwise an attestation computed with one of them.
attestationChecks : [Text] -> Api.RoundView -> [(Api.RejectionReason, Bool)]
attestationChecks [] round =
  [("round carries an attestation but the verifier names no keys", isNone round.attestation)]
attestationChecks keys round = case round.attestation of
  None -> [("round carries no attestation", False)]
  Some attestation ->
    [ ("round attestation matches no key", attestation `elem` [ testAttestation key round | key <- keys ]) ]
