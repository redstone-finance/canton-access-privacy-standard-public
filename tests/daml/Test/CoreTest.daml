-- | Tests of the reference implementation against the test verifier:
-- bootstrap, publication and its rejections, distribution, sublicensing,
-- revocation, and the visibility claims the standard makes.
module Test.CoreTest where

import DA.Action (foldlA)
import DA.Assert ((===))
import DA.Foldable (foldMap)
import DA.List (sort, unzip3, (!!))
import qualified DA.TextMap as TM
import DA.Time (addRelTime, days, hours, minutes, seconds)
import Daml.Script

import qualified Caps.Api.CoreV1 as Api
import Caps.Core.Capsule (Capsule(..))
import Caps.Core.DataDefinition
import Caps.Core.License (License(..), License_Revoke(..))
import Caps.Core.Round (Round(..))
import Caps.Core.RoundHead (RoundHead(..), RoundHead_Pause(..), RoundHead_Resume(..))
import Caps.Test.Fixtures.ForeignLicense
import Caps.Test.Fixtures.ForeignRound
import Caps.Test.Fixtures.Settlement
import Caps.Test.Fixtures.TestVerifier
import DataStandard.DataPointV1
  (PublishedDataPoint, PublishedDataPoint_Fetch(..), PublishedDataPointView(..))
import DataStandard.Utils (AnyValue(..), emptyMetadata)

-- Fixture -------------------------------------------------------------------

data Feed = Feed with
    operator : Party
    auditor1 : Party
    auditor2 : Party
    reader : Party
    licensee : Party
    client1 : Party
    client2 : Party
    publisher : Party
    stranger : Party
    verifier : ContractId Api.Verifier
    definition : ContractId Api.DataDefinition
    head : ContractId Api.RoundHead
    rootLicense : ContractId Api.License

nodesTag : Text
nodesTag = "signed-by-nodes"

-- | The secret the data producer attests rounds with, named by the verifier.
attestationKey : Text
attestationKey = "producer-key"

-- | Bootstrap a feed: verifier, proposal accepted by both auditors,
-- finalization, root license naming `licensee` and `publisher`. A choice can
-- only be exercised on contracts its submitter can see, so a publisher must
-- see the head, the verifier and the root license: the publisher here is a
-- reader, a licensee and an observer of the head, the stranger uses
-- disclosure. The reader observes the rounds alone.
setup : Script Feed
setup = do
  operator <- allocateParty "Operator"
  auditor1 <- allocateParty "Auditor1"
  auditor2 <- allocateParty "Auditor2"
  reader <- allocateParty "Reader"
  licensee <- allocateParty "Licensee"
  client1 <- allocateParty "Client1"
  client2 <- allocateParty "Client2"
  publisher <- allocateParty "Publisher"
  stranger <- allocateParty "Stranger"

  verifierCid <- submit operator $ createCmd TestVerifier with
    owner = operator, acceptedTag = nodesTag, attestationKeys = [attestationKey]
    observers = [reader, publisher], maxBehind = hours 1, maxAhead = minutes 5
  let verifier = toInterfaceContractId @Api.Verifier verifierCid

  proposal0 <- submit operator $ createCmd DefinitionProposal with
    dataId = "BTC/USD"
    operator
    auditors = [auditor1, auditor2]
    readers = [reader, publisher]
    headObservers = [licensee, publisher]
    verifier
    publishers = None
    accepted = []
  proposal1 <- submit auditor1 $ exerciseCmd proposal0 DefinitionProposal_Accept with auditor = auditor1
  -- The operator cannot finalize before every auditor has accepted.
  submitMustFailWith (actAs operator) "not all auditors have accepted" $
    exerciseCmd proposal1 DefinitionProposal_Finalize
  proposal2 <- submit auditor2 $ exerciseCmd proposal1 DefinitionProposal_Accept with auditor = auditor2
  (definitionCid, headCid) <- submit operator $ exerciseCmd proposal2 DefinitionProposal_Finalize
  let definition = toInterfaceContractId @Api.DataDefinition definitionCid
      head = toInterfaceContractId @Api.RoundHead headCid

  rootLicense <- createRootLicense operator [licensee, publisher] definition

  -- The genesis round carries the bootstrap time and a fixing must be
  -- strictly later; on the static-time test ledger that means moving on.
  passTime (minutes 1)
  pure Feed with ..

-- | The parties that sign the feed's definition, head and rounds.
chainSignatories : Feed -> [Party]
chainSignatories feed = [feed.operator, feed.auditor1, feed.auditor2]

-- | A data point as the publisher would build it: the fixing time is `at`,
-- the distributor the operator.
dataPointAt : Feed -> Time -> Decimal -> PublishedDataPointView
dataPointAt feed at price = PublishedDataPointView with
  distributor = feed.operator
  publishedAt = at
  schemaVersion = "quote-1"
  values = TM.fromList [("feedId", AVText "BTC/USD"), ("price", AVDecimal price)]
  metadata = emptyMetadata

contentAt : Feed -> Time -> Decimal -> Api.CapsuleContent
contentAt feed at price = Api.CapsuleContent with
  dataPoint = dataPointAt feed at price
  payload = AVText nodesTag
  license = feed.rootLicense

-- | Publish a round at `at` on `head`, as `actor`, attested with the data
-- producer's key.
publish : Feed -> Party -> ContractId Api.RoundHead -> Time -> Decimal -> Script Api.CreateRoundResult
publish feed actor head at price = do
  attestation <- attestationFor feed head at price
  submit actor $ exerciseCmd head Api.RoundHead_CreateRound with
    actor
    content = contentAt feed at price
    attestation

-- | The attestation of the round `head` would create at `at`: the operator
-- reads the head for the next round number.
attestationFor : Feed -> ContractId Api.RoundHead -> Time -> Decimal -> Script (Optional Text)
attestationFor feed head at price = do
  Some headView <- queryInterfaceContractId feed.operator head
  pure $ Some $ testAttestation attestationKey Api.RoundView with
    definition = feed.definition, roundNumber = headView.roundNumber + 1, timestamp = at
    dataHash = testCommitment (dataPointAt feed at price), attestation = None

createRootLicense : Party -> [Party] -> ContractId Api.DataDefinition -> Script (ContractId Api.License)
createRootLicense operator licensees definition =
  toInterfaceContractId @Api.License <$> submit operator (createCmd License with
    definition
    owner = operator
    licensor = operator
    operator
    licensees
    licenseType = AVText "root"
    validUntil = None
    delegate = None)

-- | A canonical verifier for another definition: a key attests the rounds
-- of one definition only, so each definition gets an instance, and a key,
-- of its own.
verifierFor : Feed -> Text -> Script (ContractId Api.Verifier)
verifierFor feed dataId = toInterfaceContractId <$> submit feed.operator (createCmd TestVerifier with
  owner = feed.operator, acceptedTag = nodesTag, attestationKeys = [dataId <> "-key"]
  observers = [feed.reader, feed.publisher], maxBehind = hours 1, maxAhead = minutes 5)

bootstrapDefinition
  : Feed -> Text -> Optional [Party] -> Script (ContractId Api.DataDefinition, ContractId Api.RoundHead)
bootstrapDefinition feed dataId publishers = do
  verifier <- verifierFor feed dataId
  proposal <- submit feed.operator $ createCmd DefinitionProposal with
    dataId, operator = feed.operator, auditors = [], readers = [feed.reader, feed.publisher]
    headObservers = [feed.licensee, feed.publisher], verifier, publishers, accepted = []
  (definitionCid, headCid) <- submit feed.operator $ exerciseCmd proposal DefinitionProposal_Finalize
  pure (toInterfaceContractId definitionCid, toInterfaceContractId headCid)

-- | Submit and expect the transaction to fail on the assertion carrying
-- `message`, so that a rejection test cannot pass for another reason, such
-- as a contract the submitter does not see.
submitMustFailWith : SubmitOptions -> Text -> Commands a -> Script ()
submitMustFailWith opts message commands = do
  result <- trySubmit opts commands
  case result of
    Left (FailureStatusError status) -> status.message === message
    Left other -> fail $ "unexpected failure: " <> show other
    Right _ -> fail "expected the submission to fail"

-- Publication ---------------------------------------------------------------

testBootstrapCreatesGenesis : Script ()
testBootstrapCreatesGenesis = do
  feed <- setup
  [(_, genesis)] <- query @Round feed.reader
  genesis.roundNumber === 0
  genesis.definition === feed.definition
  Some headView <- queryInterfaceContractId feed.licensee feed.head
  headView.isPaused === False
  headView.definition === feed.definition
  -- A reader observes the rounds, not the head.
  None <- queryInterfaceContractId feed.reader feed.head
  pure ()

testGenesisCarriesNoDataHash : Script ()
testGenesisCarriesNoDataHash = do
  feed <- setup
  [(_, genesis)] <- query @Round feed.reader
  genesis.dataHash === ""

testDefinitionNamesItsVerifier : Script ()
testDefinitionNamesItsVerifier = do
  feed <- setup
  Some definitionView <- queryInterfaceContractId feed.reader feed.definition
  definitionView === Api.DataDefinitionView with dataId = "BTC/USD", verifier = feed.verifier

testPublishRound : Script ()
testPublishRound = do
  feed <- setup
  now <- getTime
  result <- publish feed feed.publisher feed.head now 50000.0

  -- The old head is consumed, the new one points at round 1.
  None <- queryInterfaceContractId feed.licensee feed.head
  Some headView <- queryInterfaceContractId feed.licensee result.head
  headView.round === result.round
  headView.roundNumber === 1
  Some roundView <- queryInterfaceContractId feed.reader result.round
  roundView.roundNumber === 1
  roundView.timestamp === now
  roundView.dataHash === testCommitment (dataPointAt feed now 50000.0)

  -- The root capsule is visible to the operator, the auditors and the
  -- licensees of the root license (the publisher is one), and to nobody
  -- else: not to readers. A reader does not observe the head either: an
  -- observer of the consumed head would witness the whole publication, the
  -- root capsule included, which an active-contract query cannot show.
  Some _ <- queryInterfaceContractId feed.operator result.capsule
  Some _ <- queryInterfaceContractId feed.auditor1 result.capsule
  Some _ <- queryInterfaceContractId feed.licensee result.capsule
  Some _ <- queryInterfaceContractId feed.publisher result.capsule
  None <- queryInterfaceContractId feed.reader result.capsule
  None <- queryInterfaceContractId feed.reader result.head

  -- Two consecutive rounds advance the chain.
  passTime (minutes 1)
  later <- getTime
  result2 <- publish feed feed.publisher result.head later 50100.0
  Some roundView2 <- queryInterfaceContractId feed.reader result2.round
  roundView2.roundNumber === 2
  pure ()

testPublicationIsOpen : Script ()
testPublicationIsOpen = do
  feed <- setup
  now <- getTime
  -- A party with no relation to the feed cannot see the head, so it cannot
  -- exercise on it...
  submitMustFail feed.stranger $ exerciseCmd feed.head Api.RoundHead_CreateRound with
    actor = feed.stranger, content = contentAt feed now 50000.0, attestation = None
  -- ...but with the head, the verifier and the root license disclosed to
  -- it, and no round, it can publish authentic data: the authority to sign
  -- the round comes from the head, not from the caller.
  Some headDisc <- queryDisclosure feed.operator (fromInterfaceContractId @RoundHead feed.head)
  Some verifierDisc <- queryDisclosure feed.reader (fromInterfaceContractId @TestVerifier feed.verifier)
  Some licenseDisc <- queryDisclosure feed.operator (fromInterfaceContractId @License feed.rootLicense)
  attestation <- attestationFor feed feed.head now 50000.0
  result <- submit (actAs feed.stranger <> disclose headDisc
                    <> disclose verifierDisc <> disclose licenseDisc) $
    exerciseCmd feed.head Api.RoundHead_CreateRound with
      actor = feed.stranger, content = contentAt feed now 50000.0, attestation
  Some roundView <- queryInterfaceContractId feed.reader result.round
  roundView.roundNumber === 1

testRejectsNonMonotonicFixingTime : Script ()
testRejectsNonMonotonicFixingTime = do
  feed <- setup
  now <- getTime
  result <- publish feed feed.publisher feed.head now 50000.0
  -- Same fixing time as the previous round: refused.
  submitMustFailWith (actAs feed.publisher) "fixing time not after the previous round" $
    exerciseCmd result.head Api.RoundHead_CreateRound with
      actor = feed.publisher, content = contentAt feed now 50000.0, attestation = None

testRejectsFixingTimeOutsideWindow : Script ()
testRejectsFixingTimeOutsideWindow = do
  feed <- setup
  passTime (days 1)
  now <- getTime
  let stale = contentAt feed (addRelTime now (negate (hours 2))) 50000.0
      future = contentAt feed (addRelTime now (minutes 10)) 50000.0
  submitMustFailWith (actAs feed.publisher) "the verifier rejected the fixing time: [\"fixing time too far in the past\"]" $
    exerciseCmd feed.head Api.RoundHead_CreateRound with
      actor = feed.publisher, content = stale, attestation = None
  submitMustFailWith (actAs feed.publisher) "the verifier rejected the fixing time: [\"fixing time too far in the future\"]" $
    exerciseCmd feed.head Api.RoundHead_CreateRound with
      actor = feed.publisher, content = future, attestation = None

testRejectsInauthenticPayload : Script ()
testRejectsInauthenticPayload = do
  feed <- setup
  now <- getTime
  submitMustFailWith (actAs feed.publisher) "the verifier rejected the content: [\"payload is not authentic\"]" $
    exerciseCmd feed.head Api.RoundHead_CreateRound with
      actor = feed.publisher
      attestation = None
      content = (contentAt feed now 50000.0) with payload = AVText "forged"

-- | Where the verifier names attestation keys, a round needs the data
-- producer's attestation: none, or one computed with a key the verifier
-- does not name, and the head refuses the round.
testRejectsUnattestedRound : Script ()
testRejectsUnattestedRound = do
  feed <- setup
  now <- getTime
  submitMustFailWith (actAs feed.publisher) "the verifier rejected the round: [\"round carries no attestation\"]" $
    exerciseCmd feed.head Api.RoundHead_CreateRound with
      actor = feed.publisher, content = contentAt feed now 50000.0, attestation = None
  let foreign = testAttestation "another-key" Api.RoundView with
        definition = feed.definition, roundNumber = 1, timestamp = now
        dataHash = testCommitment (dataPointAt feed now 50000.0), attestation = None
  submitMustFailWith (actAs feed.publisher) "the verifier rejected the round: [\"round attestation matches no key\"]" $
    exerciseCmd feed.head Api.RoundHead_CreateRound with
      actor = feed.publisher, content = contentAt feed now 50000.0, attestation = Some foreign

-- | The key holder signs one candidate per round number and retries with
-- it: a publication refused while paused goes through unchanged once
-- publication resumes, with the same attestation.
testRetryKeepsTheCandidate : Script ()
testRetryKeepsTheCandidate = do
  feed <- setup
  now <- getTime
  attestation <- attestationFor feed feed.head now 50000.0
  pausedCid <- submit feed.auditor1 $ exerciseCmd (fromInterfaceContractId @RoundHead feed.head)
    RoundHead_Pause with auditor = feed.auditor1
  submitMustFailWith (actAs feed.publisher) "publication is paused" $
    exerciseCmd (toInterfaceContractId @Api.RoundHead pausedCid) Api.RoundHead_CreateRound with
      actor = feed.publisher, content = contentAt feed now 50000.0, attestation
  resumedCid <- submit feed.auditor1 $ exerciseCmd pausedCid RoundHead_Resume with auditor = feed.auditor1
  passTime (minutes 10)
  result <- submit feed.publisher $
    exerciseCmd (toInterfaceContractId @Api.RoundHead resumedCid) Api.RoundHead_CreateRound with
      actor = feed.publisher, content = contentAt feed now 50000.0, attestation
  Some roundView <- queryInterfaceContractId feed.reader result.round
  roundView.attestation === attestation

-- | A candidate signed for a round number and never published stays
-- attested after the key holder, past the window, has signed another for
-- the same number: what retires it is the window. A party without the
-- round finds its attestation valid and its fixing stale.
testStaleCandidateFailsFreshness : Script ()
testStaleCandidateFailsFreshness = do
  feed <- setup
  first <- getTime
  staleAttestation <- attestationFor feed feed.head first 50000.0
  -- Publication fails for longer than the window; the key holder signs a
  -- new candidate for the same number and that one becomes the round.
  passTime (hours 1 + minutes 6)
  second <- getTime
  result <- publish feed feed.publisher feed.head second 50100.0
  Some roundView <- queryInterfaceContractId feed.reader result.round
  roundView.timestamp === second
  let staleCapsule = Api.CapsuleView with
        definition = feed.definition, roundNumber = 1, content = contentAt feed first 50000.0
      staleView = Api.RoundView with
        definition = feed.definition, roundNumber = 1, timestamp = first
        dataHash = testCommitment (dataPointAt feed first 50000.0), attestation = staleAttestation
  ownCid <- submit feed.client1 $ createCmd TestVerifier with
    owner = feed.client1, acceptedTag = nodesTag, attestationKeys = [attestationKey]
    observers = [], maxBehind = hours 1, maxAhead = minutes 5
  let own = toInterfaceContractId @Api.Verifier ownCid
  canonical <- submit feed.client1 $ exerciseCmd own Api.Verifier_VerifyRound with
    actor = feed.client1, capsule = staleCapsule, round = staleView
  canonical === Api.Passed
  now <- getTime
  fresh <- submit feed.client1 $ exerciseCmd own Api.Verifier_VerifyFreshness with
    actor = feed.client1, capsule = staleCapsule, asOf = now
  fresh === Api.Failed ["fixing time too far in the past"]

testRejectsForeignLicense : Script ()
testRejectsForeignLicense = do
  feed <- setup
  now <- getTime
  -- A license owned by someone other than the operator cannot back a root
  -- capsule, even for the right definition. The publisher is a licensee of
  -- it, so it sees the license and the head reaches the ownership check.
  foreignCid <- submit feed.licensee $ createCmd License with
    definition = feed.definition, owner = feed.licensee, licensor = feed.operator
    operator = feed.operator, licensees = [feed.publisher], licenseType = AVText "x"
    validUntil = None, delegate = None
  submitMustFailWith (actAs feed.publisher) "root license must be owned by the operator" $
    exerciseCmd feed.head Api.RoundHead_CreateRound with
      actor = feed.publisher
      attestation = None
      content = (contentAt feed now 50000.0) with license = toInterfaceContractId foreignCid

-- A license of another template may name the operator as its owner, and
-- any licensees, in its view. The head goes by who signed it, or a
-- publisher would choose who receives the operator's root capsule.
testRejectsALicenseTheOperatorDidNotSign : Script ()
testRejectsALicenseTheOperatorDidNotSign = do
  feed <- setup
  now <- getTime
  forged <- submit feed.publisher $ createCmd ForeignLicense with
    owner = feed.publisher
    shown = Api.LicenseView with
      definition = feed.definition, owner = feed.operator
      licensees = [feed.licensee, feed.publisher, feed.stranger], delegate = None
  attestation <- attestationFor feed feed.head now 50000.0
  submitMustFailWith (actAs feed.publisher) "root license is not signed by the operator" $
    exerciseCmd feed.head Api.RoundHead_CreateRound with
      actor = feed.publisher
      attestation
      content = (contentAt feed now 50000.0) with license = toInterfaceContractId forged

testRejectsLicenseOfAnotherDefinition : Script ()
testRejectsLicenseOfAnotherDefinition = do
  feed <- setup
  now <- getTime
  (otherDefinition, _) <- bootstrapDefinition feed "ETH/USD" None
  license <- createRootLicense feed.operator [feed.licensee, feed.publisher] otherDefinition
  submitMustFailWith (actAs feed.publisher) "license belongs to another definition" $
    exerciseCmd feed.head Api.RoundHead_CreateRound with
      actor = feed.publisher
      attestation = None
      content = (contentAt feed now 50000.0) with license

testRejectsDataPointOfAnotherDistributor : Script ()
testRejectsDataPointOfAnotherDistributor = do
  feed <- setup
  now <- getTime
  let dataPoint = (dataPointAt feed now 50000.0) with distributor = feed.publisher
  submitMustFailWith (actAs feed.publisher) "root capsule must be distributed by the operator" $
    exerciseCmd feed.head Api.RoundHead_CreateRound with
      actor = feed.publisher
      attestation = None
      content = (contentAt feed now 50000.0) with dataPoint

testRejectsPublisherNotAdmitted : Script ()
testRejectsPublisherNotAdmitted = do
  feed <- setup
  (definition, head) <- bootstrapDefinition feed "ETH/USD" (Some [])
  license <- createRootLicense feed.operator [feed.licensee, feed.publisher] definition
  passTime (minutes 1)
  now <- getTime
  submitMustFailWith (actAs feed.publisher) "publisher not admitted" $
    exerciseCmd head Api.RoundHead_CreateRound with
      actor = feed.publisher
      attestation = None
      content = (contentAt feed now 50000.0) with license

-- | An observer of the head witnesses every publication in full, so the head
-- refuses to publish while one of its observers is outside the root
-- capsule's audience: here the reader, who holds no license.
testRejectsHeadObserverOutsideTheAudience : Script ()
testRejectsHeadObserverOutsideTheAudience = do
  feed <- setup
  verifier <- verifierFor feed "ETH/USD"
  proposal <- submit feed.operator $ createCmd DefinitionProposal with
    dataId = "ETH/USD", operator = feed.operator, auditors = [], readers = [feed.reader]
    headObservers = [feed.reader], verifier, publishers = None, accepted = []
  (definitionCid, headCid) <- submit feed.operator $ exerciseCmd proposal DefinitionProposal_Finalize
  let definition = toInterfaceContractId @Api.DataDefinition definitionCid
  license <- createRootLicense feed.operator [feed.licensee] definition
  passTime (minutes 1)
  now <- getTime
  submitMustFailWith (actAs feed.operator) "head observer outside the root capsule's audience" $
    exerciseCmd (toInterfaceContractId @Api.RoundHead headCid) Api.RoundHead_CreateRound with
      actor = feed.operator
      attestation = None
      content = (contentAt feed now 50000.0) with license

testRaceOnHead : Script ()
testRaceOnHead = do
  feed <- setup
  now <- getTime
  _ <- publish feed feed.publisher feed.head now 50000.0
  -- A second publication against the consumed head fails entirely.
  submitMustFail feed.publisher $ exerciseCmd feed.head Api.RoundHead_CreateRound with
    actor = feed.publisher, content = contentAt feed (addRelTime now (minutes 1)) 50100.0, attestation = None

testPauseAndResume : Script ()
testPauseAndResume = do
  feed <- setup
  now <- getTime
  pausedCid <- submit feed.auditor1 $ exerciseCmd (fromInterfaceContractId @RoundHead feed.head)
    RoundHead_Pause with auditor = feed.auditor1
  let paused = toInterfaceContractId @Api.RoundHead pausedCid
  submitMustFailWith (actAs feed.publisher) "publication is paused" $
    exerciseCmd paused Api.RoundHead_CreateRound with
      actor = feed.publisher, content = contentAt feed now 50000.0, attestation = None
  -- A licensee sees the head but is no auditor, so it cannot resume.
  submitMustFailWith (actAs feed.licensee) "not an auditor" $
    exerciseCmd pausedCid RoundHead_Resume with auditor = feed.licensee
  resumedCid <- submit feed.auditor2 $ exerciseCmd pausedCid RoundHead_Resume with auditor = feed.auditor2
  _ <- publish feed feed.publisher (toInterfaceContractId resumedCid) now 50000.0
  pure ()

-- | A proposal that will not be finalized is cancelled by the operator,
-- with the acceptors' authority from the contract. Nobody else touches it.
testProposalCanBeCancelled : Script ()
testProposalCanBeCancelled = do
  feed <- setup
  verifier <- verifierFor feed "ETH/USD"
  let newProposal = submit feed.operator $ createCmd DefinitionProposal with
        dataId = "ETH/USD", operator = feed.operator, auditors = [feed.auditor1, feed.auditor2]
        readers = [feed.reader], headObservers = [], verifier, publishers = None, accepted = []
  proposal0 <- newProposal
  proposal1 <- submit feed.auditor1 $ exerciseCmd proposal0 DefinitionProposal_Accept with auditor = feed.auditor1
  -- Once an auditor has accepted, the operator cannot archive the proposal
  -- directly, and no auditor can cancel it.
  submitMustFail feed.operator $ archiveCmd proposal1
  submitMustFail feed.auditor1 $ exerciseCmd proposal1 DefinitionProposal_Cancel
  submit feed.operator $ exerciseCmd proposal1 DefinitionProposal_Cancel
  remaining <- queryContractId feed.operator proposal1
  remaining === None

testOperatorCannotArchiveAlone : Script ()
testOperatorCannotArchiveAlone = do
  feed <- setup
  submitMustFail feed.operator $ archiveCmd (fromInterfaceContractId @RoundHead feed.head)
  submitMustFail feed.operator $ archiveCmd (fromInterfaceContractId @DataDefinition feed.definition)
  [(genesis, _)] <- query @Round feed.reader
  submitMustFail feed.operator $ archiveCmd genesis

-- | A round is co-signed by the auditors, so the operator cannot create one
-- outside the chain, whatever number or commitment it claims.
testOperatorCannotMintARoundAlone : Script ()
testOperatorCannotMintARoundAlone = do
  feed <- setup
  [(_, genesis)] <- query @Round feed.reader
  now <- getTime
  submitMustFail feed.operator $ createCmd genesis with
    roundNumber = 1, timestamp = now, dataHash = "forged"

-- | Two rounds after the genesis round, a minute apart; returns them.
publishTwo feed = do
  first <- getTime
  result1 <- publish feed feed.publisher feed.head first 50000.0
  passTime (minutes 1)
  second <- getTime
  result2 <- publish feed feed.publisher result1.head second 50100.0
  pure (result1.round, result2.round)

testOperatorRetiresAnOlderRound : Script ()
testOperatorRetiresAnOlderRound = do
  feed <- setup
  (round1, _) <- publishTwo feed
  -- The operator retires round 1 with the auditors' authority the round
  -- carries.
  submit feed.operator $ exerciseCmd round1 Api.Round_Archive with actor = feed.operator
  None <- queryInterfaceContractId feed.reader round1
  pure ()

testGenesisRoundIsLeftToTheArchiver : Script ()
testGenesisRoundIsLeftToTheArchiver = do
  feed <- setup
  _ <- publishTwo feed
  -- The round checks only its actor; keeping the genesis round is an
  -- archiver's rule, since nothing on the ledger needs it.
  [(genesis, _)] <- filter (\(_, round) -> round.roundNumber == 0) <$> query @Round feed.reader
  submit feed.operator $ exerciseCmd (toInterfaceContractId @Api.Round genesis) Api.Round_Archive with
    actor = feed.operator
  None <- queryContractId feed.reader genesis
  pure ()

-- | Retiring the latest round does not stop publication: the head carries
-- the latest round's number and fixing time, so a publication fetches no
-- round. Keeping the latest round is an archiver's rule too.
testPublicationSurvivesArchivingTheLatestRound : Script ()
testPublicationSurvivesArchivingTheLatestRound = do
  feed <- setup
  now <- getTime
  result1 <- publish feed feed.publisher feed.head now 50000.0
  submit feed.operator $ exerciseCmd result1.round Api.Round_Archive with actor = feed.operator
  None <- queryInterfaceContractId feed.reader result1.round
  passTime (minutes 1)
  later <- getTime
  result2 <- publish feed feed.publisher result1.head later 50100.0
  Some headView <- queryInterfaceContractId feed.licensee result2.head
  headView.roundNumber === 2
  Some roundView <- queryInterfaceContractId feed.reader result2.round
  roundView.roundNumber === 2
  roundView.timestamp === later

testOnlyTheOperatorRetiresARound : Script ()
testOnlyTheOperatorRetiresARound = do
  feed <- setup
  (round1, _) <- publishTwo feed
  submitMustFailWith (actAs feed.auditor1) "only the operator retires a round" $
    exerciseCmd round1 Api.Round_Archive with actor = feed.auditor1

-- Distribution --------------------------------------------------------------

-- | Publish one round and let the licensee sublicense. Returns the root
-- capsule view and the licensee's license.
distributionFixture : Script (Feed, Api.CapsuleView, ContractId Api.License, Api.CreateRoundResult)
distributionFixture = do
  feed <- setup
  now <- getTime
  result <- publish feed feed.publisher feed.head now 50000.0
  Some rootView <- queryInterfaceContractId feed.licensee result.capsule
  sublicense <- submit feed.licensee $ exerciseCmd feed.rootLicense Api.License_CreateSublicense with
    actor = feed.licensee, licenseType = AVText "redistribution", licensees = [feed.client1]
  pure (feed, rootView, sublicense, result)

-- | A counterparty that consented in advance: Bob, who is not a reader,
-- signs a settlement Alice settles alone, on a capsule and a round view she
-- supplies. The contract accepts the round's view as the ledger carries it
-- and refuses an authentic capsule with a view nothing attested, or with
-- the round's attestation over another commitment: which authentic
-- payload is the round is the key holder's choice, not Alice's.
testSettlementOnSuppliedView : Script ()
testSettlementOnSuppliedView = do
  (feed, rootView, sublicense, result) <- distributionFixture
  capsule <- submit feed.licensee $ exerciseCmd sublicense Api.License_Distribute with
    source = Api.ByView rootView, clients = [feed.client1]
  Some capsuleView <- queryInterfaceContractId feed.client1 capsule
  Some roundView <- queryInterfaceContractId feed.reader result.round
  -- Bob pins the parameters in an instance of his own that Alice exercises.
  verifierCid <- submit feed.client2 $ createCmd TestVerifier with
    owner = feed.client2, acceptedTag = nodesTag, attestationKeys = [attestationKey]
    observers = [feed.client1], maxBehind = hours 1, maxAhead = minutes 5
  settlement <- submit (actAs feed.client1 <> actAs feed.client2) $ createCmd Settlement with
    a = feed.client1, b = feed.client2, definition = feed.definition
    verifier = toInterfaceContractId verifierCid
    roundSignatories = chainSignatories feed, fixing = AnyFreshRound
  -- Another authentic payload for the round, with a view that agrees with it.
  let other = capsuleView with content = contentAt feed roundView.timestamp 51000.0
      otherView = roundView with
        dataHash = testCommitment other.content.dataPoint, attestation = None
  submitMustFailWith (actAs feed.client1) "not canonical: [\"round carries no attestation\"]" $
    exerciseCmd settlement Settlement_Settle with capsule = other, round = otherView
  submitMustFailWith (actAs feed.client1) "not canonical: [\"round attestation matches no key\"]" $
    exerciseCmd settlement Settlement_Settle with
      capsule = other, round = otherView with attestation = roundView.attestation
  settled <- submit feed.client1 $ exerciseCmd settlement Settlement_Settle with
    capsule = capsuleView, round = roundView
  Some record <- queryContractId feed.client2 settled
  record.roundNumber === roundView.roundNumber
  record.dataPoint === capsuleView.content.dataPoint

-- A reader takes a round's view inside a transaction as its observer.
testRoundIsFetchedByAReader : Script ()
testRoundIsFetchedByAReader = do
  feed <- setup
  now <- getTime
  result <- publish feed feed.publisher feed.head now 50000.0
  fetched <- submit feed.reader $ exerciseCmd result.round Api.Round_Fetch with
    actor = feed.reader, signatories = chainSignatories feed
  Some roundView <- queryInterfaceContractId feed.reader result.round
  fetched === roundView

-- A party that is no reader takes a round's view inside a transaction once
-- the round is disclosed to it, and not before.
testRoundIsFetchedByDisclosure : Script ()
testRoundIsFetchedByDisclosure = do
  feed <- setup
  now <- getTime
  result <- publish feed feed.publisher feed.head now 50000.0
  let fetchAs signatories = exerciseCmd result.round Api.Round_Fetch with
        actor = feed.client1, signatories
  submitMustFail feed.client1 $ fetchAs $ chainSignatories feed
  Some roundDisc <- queryDisclosure feed.reader (fromInterfaceContractId @Round result.round)
  fetched <- submit (actAs feed.client1 <> disclose roundDisc) $ fetchAs $ chainSignatories feed
  Some roundView <- queryInterfaceContractId feed.reader result.round
  fetched === roundView
  -- The round is the chain's only for a caller that names who signs the
  -- chain: one auditor short, or the operator alone, is refused.
  submitMustFailWith (actAs feed.client1 <> disclose roundDisc)
    "round is not signed by the named signatories" $ fetchAs [feed.operator, feed.auditor1]
  submitMustFailWith (actAs feed.client1 <> disclose roundDisc)
    "round is not signed by the named signatories" $ fetchAs [feed.operator]

-- Alice, who is no reader, settles on the round the ledger holds: a view of
-- her own making has no way in, and an authentic capsule that is not the
-- round's fails against the round itself.
testSettlementOnTheLedgersRound : Script ()
testSettlementOnTheLedgersRound = do
  (feed, rootView, sublicense, result) <- distributionFixture
  capsule <- submit feed.licensee $ exerciseCmd sublicense Api.License_Distribute with
    source = Api.ByView rootView, clients = [feed.client1]
  Some capsuleView <- queryInterfaceContractId feed.client1 capsule
  Some roundView <- queryInterfaceContractId feed.reader result.round
  Some roundDisc <- queryDisclosure feed.reader (fromInterfaceContractId @Round result.round)
  verifierCid <- submit feed.client2 $ createCmd TestVerifier with
    owner = feed.client2, acceptedTag = nodesTag, attestationKeys = [attestationKey]
    observers = [feed.client1], maxBehind = hours 1, maxAhead = minutes 5
  settlement <- submit (actAs feed.client1 <> actAs feed.client2) $ createCmd Settlement with
    a = feed.client1, b = feed.client2, definition = feed.definition
    verifier = toInterfaceContractId verifierCid
    roundSignatories = chainSignatories feed, fixing = AnyFreshRound
  let other = capsuleView with content = contentAt feed roundView.timestamp 51000.0
  submitMustFailWith (actAs feed.client1 <> disclose roundDisc) "not canonical: [\"commitment mismatch\"]" $
    exerciseCmd settlement Settlement_SettleOnRound with capsule = other, round = result.round
  settled <- submit (actAs feed.client1 <> disclose roundDisc) $
    exerciseCmd settlement Settlement_SettleOnRound with
      capsule = capsuleView, round = result.round
  Some record <- queryContractId feed.client2 settled
  record.roundNumber === roundView.roundNumber

-- Fixing rules ----------------------------------------------------------------

-- | Three rounds a minute apart, all fresh together, each distributed to
-- Alice (client1), who is no reader; and a settlement of Alice and Bob
-- (client2) on `fixing`, which Alice settles alone.
data Fixings = Fixings with
    feed : Feed
    settlement : ContractId Settlement
    genesis : ContractId Api.Round
    rounds : [Api.CreateRoundResult]
    capsules : [Api.CapsuleView]
      -- ^ Alice's capsules of the three rounds.
    times : [Time]
      -- ^ The fixing times of the three rounds.

fixings : (Time -> FixingRule) -> Script Fixings
fixings rule = do
  feed <- setup
  Some genesisHead <- queryInterfaceContractId feed.operator feed.head
  sublicense <- submit feed.licensee $ exerciseCmd feed.rootLicense Api.License_CreateSublicense with
    actor = feed.licensee, licenseType = AVText "redistribution", licensees = [feed.client1]
  let fix (head, done) price = do
        passTime (minutes 1)
        at <- getTime
        result <- publish feed feed.publisher head at price
        Some rootView <- queryInterfaceContractId feed.licensee result.capsule
        capsule <- submit feed.licensee $ exerciseCmd sublicense Api.License_Distribute with
          source = Api.ByView rootView, clients = [feed.client1]
        Some capsuleView <- queryInterfaceContractId feed.client1 capsule
        pure (result.head, done <> [(result, capsuleView, at)])
  (_, fixed) <- foldlA fix (feed.head, []) [50000.0, 50100.0, 50200.0]
  let (rounds, capsules, times) = unzip3 fixed
      first :: _ = times
  verifierCid <- submit feed.client2 $ createCmd TestVerifier with
    owner = feed.client2, acceptedTag = nodesTag, attestationKeys = [attestationKey]
    observers = [feed.client1], maxBehind = hours 1, maxAhead = minutes 5
  settlement <- submit (actAs feed.client1 <> actAs feed.client2) $ createCmd Settlement with
    a = feed.client1, b = feed.client2, definition = feed.definition
    verifier = toInterfaceContractId verifierCid
    roundSignatories = chainSignatories feed, fixing = rule first
  pure Fixings with feed, settlement, genesis = genesisHead.round, rounds, capsules, times

-- | The view of `round` as the readers party reads it.
roundViewOf : Feed -> Api.CreateRoundResult -> Script Api.RoundView
roundViewOf feed result = do
  Some view <- queryInterfaceContractId feed.reader result.round
  pure view

-- Without a rule Alice settles on whichever fresh round suits her; with the
-- round number agreed, only on that round.
testSettlementHoldsTheAgreedRound : Script ()
testSettlementHoldsTheAgreedRound = do
  unpinned <- fixings $ const AnyFreshRound
  let [_, _, latestCapsule] = unpinned.capsules
      [_, _, latest] = unpinned.rounds
  latestView <- roundViewOf unpinned.feed latest
  _ <- submit unpinned.feed.client1 $ exerciseCmd unpinned.settlement Settlement_Settle with
    capsule = latestCapsule, round = latestView

  pinned <- fixings $ const $ RoundNumber 2
  let [_, capsule2, capsule3] = pinned.capsules
      [_, round2, round3] = pinned.rounds
  view2 <- roundViewOf pinned.feed round2
  view3 <- roundViewOf pinned.feed round3
  submitMustFailWith (actAs pinned.feed.client1) "not the agreed round" $
    exerciseCmd pinned.settlement Settlement_Settle with capsule = capsule3, round = view3
  settled <- submit pinned.feed.client1 $ exerciseCmd pinned.settlement Settlement_Settle with
    capsule = capsule2, round = view2
  Some record <- queryContractId pinned.feed.client2 settled
  record.roundNumber === 2

-- The freshness window is the parties' to set: under a verifier of ninety
-- seconds the round of two minutes ago no longer settles, which under the
-- hour of the other tests it does.
testSettlementUnderANarrowerWindow : Script ()
testSettlementUnderANarrowerWindow = do
  f <- fixings $ const AnyFreshRound
  let alice = f.feed.client1
      bob = f.feed.client2
      [capsule1, capsule2, _] = f.capsules
  [view1, view2, _] <- mapA (roundViewOf f.feed) f.rounds
  verifierCid <- submit bob $ createCmd TestVerifier with
    owner = bob, acceptedTag = nodesTag, attestationKeys = [attestationKey]
    observers = [alice], maxBehind = seconds 90, maxAhead = minutes 5
  narrow <- submit (actAs alice <> actAs bob) $ createCmd Settlement with
    a = alice, b = bob, definition = f.feed.definition
    verifier = toInterfaceContractId verifierCid
    roundSignatories = chainSignatories f.feed, fixing = AnyFreshRound
  submitMustFailWith (actAs alice) "not fresh: [\"fixing time too far in the past\"]" $
    exerciseCmd narrow Settlement_Settle with capsule = capsule1, round = view1
  _ <- submit alice $ exerciseCmd narrow Settlement_Settle with capsule = capsule2, round = view2
  _ <- submit alice $ exerciseCmd f.settlement Settlement_Settle with capsule = capsule1, round = view1
  pure ()

-- The settlement is on the data set both parties pinned: a capsule of
-- another definition is refused whatever else it passes.
testSettlementRefusesAnotherDefinitionsCapsule : Script ()
testSettlementRefusesAnotherDefinitionsCapsule = do
  f <- fixings $ const AnyFreshRound
  let capsule1 :: _ = f.capsules
      round1 :: _ = f.rounds
  view1 <- roundViewOf f.feed round1
  (otherDefinition, _) <- bootstrapDefinition f.feed "ETH/USD" None
  submitMustFailWith (actAs f.feed.client1) "capsule of another definition" $
    exerciseCmd f.settlement Settlement_Settle with
      capsule = capsule1 with definition = otherDefinition
      round = view1 with definition = otherDefinition

-- With the fixing time agreed, only the round fixed at that time settles.
testSettlementHoldsTheAgreedFixingTime : Script ()
testSettlementHoldsTheAgreedFixingTime = do
  f <- fixings $ FixingTime . (`addRelTime` minutes 1)
  let [capsule1, capsule2, _] = f.capsules
      [round1, round2, _] = f.rounds
  view1 <- roundViewOf f.feed round1
  view2 <- roundViewOf f.feed round2
  submitMustFailWith (actAs f.feed.client1) "not the agreed fixing time" $
    exerciseCmd f.settlement Settlement_Settle with capsule = capsule1, round = view1
  settled <- submit f.feed.client1 $ exerciseCmd f.settlement Settlement_Settle with
    capsule = capsule2, round = view2
  Some record <- queryContractId f.feed.client2 settled
  record.roundNumber === 2

-- The first round at or after a time between rounds 1 and 2 is round 2, and
-- the ledger says so: Alice has the settlement fetch the round and the one
-- before it, both disclosed to her.
testSettlementOnTheFirstRoundAfterByTheLedger : Script ()
testSettlementOnTheFirstRoundAfterByTheLedger = do
  f <- fixings $ FirstRoundAtOrAfter . (`addRelTime` seconds 30)
  let alice = f.feed.client1
      [capsule1, capsule2, capsule3] = f.capsules
      [round1, round2, round3] = map (.round) f.rounds
  disclosures <- forA (f.genesis :: [round1, round2, round3]) $ \round -> do
    Some disclosure <- queryDisclosure f.feed.reader $ fromInterfaceContractId @Round round
    pure disclosure
  let shown = actAs alice <> foldMap disclose disclosures
      on capsule round previous = exerciseCmd f.settlement Settlement_SettleOnRounds with
        capsule, round, previous
  submitMustFailWith shown "the rule needs the round before" $
    exerciseCmd f.settlement Settlement_SettleOnRound with capsule = capsule2, round = round2
  submitMustFailWith shown "the round is fixed before the agreed time" $ on capsule1 round1 f.genesis
  submitMustFailWith shown "an earlier round is fixed at or after the agreed time" $ on capsule3 round3 round2
  submitMustFailWith shown "not the round before" $ on capsule3 round3 round1
  -- A round before of Alice's own making, numbered 2 and fixed before the
  -- agreed time, would make round 3 the first: it is not the chain's.
  view3 <- roundViewOf f.feed $ f.rounds !! 2
  let first :: _ = f.times
  forged <- submit alice $ createCmd ForeignRound with
    owner = alice
    shown = view3 with roundNumber = 2, timestamp = first, attestation = None
  submitMustFailWith shown "round is not signed by the named signatories" $
    on capsule3 round3 $ toInterfaceContractId forged
  -- Nor is a round of the reference template that Alice signs as its
  -- operator, which takes no other package.
  own <- submit alice $ createCmd Round with
    definition = f.feed.definition, roundNumber = 2, timestamp = first, dataHash = ""
    operator = alice, auditors = [], readers = [], attestation = None
  submitMustFailWith shown "round is not signed by the named signatories" $
    on capsule3 round3 $ toInterfaceContractId own
  -- A round before of another definition, signed as this one's are, is
  -- still not the round before.
  otherVerifier <- verifierFor f.feed "ETH/USD"
  proposal <- submit f.feed.operator $ createCmd DefinitionProposal with
    dataId = "ETH/USD", operator = f.feed.operator
    auditors = [f.feed.auditor1, f.feed.auditor2], readers = [f.feed.reader]
    headObservers = [], verifier = otherVerifier, publishers = None, accepted = []
  accepted1 <- submit f.feed.auditor1 $ exerciseCmd proposal DefinitionProposal_Accept with
    auditor = f.feed.auditor1
  accepted2 <- submit f.feed.auditor2 $ exerciseCmd accepted1 DefinitionProposal_Accept with
    auditor = f.feed.auditor2
  (_, otherHead) <- submit f.feed.operator $ exerciseCmd accepted2 DefinitionProposal_Finalize
  Some otherHeadView <- queryInterfaceContractId f.feed.operator $ toInterfaceContractId @Api.RoundHead otherHead
  Some otherGenesis <- queryDisclosure f.feed.reader $ fromInterfaceContractId @Round otherHeadView.round
  submitMustFailWith (shown <> disclose otherGenesis) "the round before is of another definition" $
    on capsule1 round1 otherHeadView.round
  settled <- submit shown $ on capsule2 round2 round1
  Some record <- queryContractId f.feed.client2 settled
  record.roundNumber === 2

-- The same rule without the ledger: Alice supplies the capsules and the
-- attested views of round 2 and of the round before it, and a view of the
-- round before that nothing attested does not pass.
testSettlementOnTheFirstRoundAfterBySuppliedViews : Script ()
testSettlementOnTheFirstRoundAfterBySuppliedViews = do
  f <- fixings $ FirstRoundAtOrAfter . (`addRelTime` seconds 30)
  let alice = f.feed.client1
      [capsule1, capsule2, capsule3] = f.capsules
  [view1, view2, view3] <- mapA (roundViewOf f.feed) f.rounds
  let on capsule round previousCapsule previous =
        exerciseCmd f.settlement Settlement_SettleWithPrevious with
          capsule, round, previousCapsule, previous
  submitMustFailWith (actAs alice) "an earlier round is fixed at or after the agreed time" $
    on capsule3 view3 capsule2 view2
  submitMustFailWith (actAs alice) "not canonical: [\"round carries no attestation\"]" $
    on capsule2 view2 capsule1 view1 with attestation = None
  settled <- submit alice $ on capsule2 view2 capsule1 view1
  Some record <- queryContractId f.feed.client2 settled
  record.roundNumber === 2

-- A contract of another template says anything in its view. Alice, with
-- the attestation key on her side, wraps a candidate the key holder signed
-- and nobody published in a round of her own. The settlement names the
-- chain's signatories, so fetching that round is refused; as a supplied
-- view the same candidate passes, which is the attestation's limit.
testRoundFetchRefusesAForeignRound : Script ()
testRoundFetchRefusesAForeignRound = do
  (feed, rootView, sublicense, result) <- distributionFixture
  capsule <- submit feed.licensee $ exerciseCmd sublicense Api.License_Distribute with
    source = Api.ByView rootView, clients = [feed.client1]
  Some capsuleView <- queryInterfaceContractId feed.client1 capsule
  Some roundView <- queryInterfaceContractId feed.reader result.round
  verifierCid <- submit feed.client2 $ createCmd TestVerifier with
    owner = feed.client2, acceptedTag = nodesTag, attestationKeys = [attestationKey]
    observers = [feed.client1], maxBehind = hours 1, maxAhead = minutes 5
  settlement <- submit (actAs feed.client1 <> actAs feed.client2) $ createCmd Settlement with
    a = feed.client1, b = feed.client2, definition = feed.definition
    verifier = toInterfaceContractId verifierCid
    roundSignatories = chainSignatories feed, fixing = AnyFreshRound
  let other = capsuleView with content = contentAt feed roundView.timestamp 51000.0
      candidate = roundView with dataHash = testCommitment other.content.dataPoint, attestation = None
      attested = candidate with attestation = Some $ testAttestation attestationKey candidate
  forged <- submit feed.client1 $ createCmd ForeignRound with owner = feed.client1, shown = attested
  submitMustFailWith (actAs feed.client1) "round is not signed by the named signatories" $
    exerciseCmd settlement Settlement_SettleOnRound with
      capsule = other, round = toInterfaceContractId forged
  _ <- submit feed.client1 $ exerciseCmd settlement Settlement_Settle with
    capsule = other, round = attested
  pure ()

testDistributeByView : Script ()
testDistributeByView = do
  (feed, rootView, sublicense, _) <- distributionFixture
  capsule <- submit feed.licensee $ exerciseCmd sublicense Api.License_Distribute with
    source = Api.ByView rootView
    clients = [feed.client1, feed.client2]

  Some v <- queryInterfaceContractId feed.client1 capsule
  v.roundNumber === rootView.roundNumber
  v.content.license === sublicense
  v.content.dataPoint.distributor === feed.licensee
  v.content.dataPoint.values === rootView.content.dataPoint.values
  v.content.payload === rootView.content.payload

  -- The Data Standard view is the same data point. `Capsule` requires
  -- `PublishedDataPoint`, so the contract id converts between the two.
  Some dp <- queryInterfaceContractId feed.client2 (toInterfaceContractId @PublishedDataPoint capsule)
  dp === v.content.dataPoint
  pure ()

testDistributeById : Script ()
testDistributeById = do
  (feed, _, sublicense, result) <- distributionFixture
  -- The licensee is an observer of the root capsule, so it may fetch it.
  capsule <- submit feed.licensee $ exerciseCmd sublicense Api.License_Distribute with
    source = Api.ById result.capsule
    clients = [feed.client1]
  Some v <- queryInterfaceContractId feed.client1 capsule
  v.content.dataPoint.distributor === feed.licensee
  pure ()

testDistributedCapsuleServesItsDataPoint : Script ()
testDistributedCapsuleServesItsDataPoint = do
  (feed, rootView, sublicense, _) <- distributionFixture
  capsule <- submit feed.licensee $ exerciseCmd sublicense Api.License_Distribute with
    source = Api.ByView rootView, clients = [feed.client1]
  Some capsuleView <- queryInterfaceContractId feed.client1 capsule
  -- The Data Standard's own read path, for a consumer written against it
  -- alone. The exercise informs the capsule's signatory, the distributor,
  -- so a CAPS consumer reads the view from its own participant instead, as
  -- the line above does.
  fetched <- submit feed.client1 $
    exerciseCmd (toInterfaceContractId @PublishedDataPoint capsule) PublishedDataPoint_Fetch with
      actor = feed.client1
  fetched === capsuleView.content.dataPoint

testConsumerVerifiesDistributedCapsule : Script ()
testConsumerVerifiesDistributedCapsule = do
  (feed, rootView, sublicense, result) <- distributionFixture
  capsule <- submit feed.licensee $ exerciseCmd sublicense Api.License_Distribute with
    source = Api.ByView rootView, clients = [feed.client1]
  Some capsuleView <- queryInterfaceContractId feed.client1 capsule
  -- The client reads the round through the readers party and verifies
  -- against a verifier instance of its own.
  Some roundView <- queryInterfaceContractId feed.reader result.round
  ownVerifierCid <- submit feed.client1 $ createCmd TestVerifier with
    owner = feed.client1, acceptedTag = nodesTag, attestationKeys = [attestationKey]
    observers = [], maxBehind = hours 1, maxAhead = minutes 5
  let ownVerifier = toInterfaceContractId @Api.Verifier ownVerifierCid
  verified <- submit feed.client1 $ exerciseCmd ownVerifier Api.Verifier_Verify with
    actor = feed.client1, capsule = capsuleView
  verified === Api.Verified roundView.dataHash
  canonical <- submit feed.client1 $ exerciseCmd ownVerifier Api.Verifier_VerifyRound with
    actor = feed.client1, capsule = capsuleView, round = roundView
  canonical === Api.Passed
  -- The view as a party that cannot read the round would receive it from
  -- the capsule's presenter: the attestation is what makes it checkable,
  -- and without it the check fails.
  unattested <- submit feed.client1 $ exerciseCmd ownVerifier Api.Verifier_VerifyRound with
    actor = feed.client1, capsule = capsuleView, round = roundView with attestation = None
  unattested === Api.Failed ["round carries no attestation"]
  -- A capsule claiming another round is reported, not aborted on.
  let lying = capsuleView with roundNumber = 7
  rejected <- submit feed.client1 $ exerciseCmd ownVerifier Api.Verifier_VerifyRound with
    actor = feed.client1, capsule = lying, round = roundView
  rejected === Api.Failed ["round number mismatch"]
  -- Freshness is judged against a reference time the consumer chooses.
  now <- getTime
  fresh <- submit feed.client1 $ exerciseCmd ownVerifier Api.Verifier_VerifyFreshness with
    actor = feed.client1, capsule = capsuleView, asOf = now
  fresh === Api.Passed
  stale <- submit feed.client1 $ exerciseCmd ownVerifier Api.Verifier_VerifyFreshness with
    actor = feed.client1, capsule = capsuleView, asOf = addRelTime now (days 1)
  stale === Api.Failed ["fixing time too far in the past"]

testDistributionIsInvisibleToOperatorAndAuditors : Script ()
testDistributionIsInvisibleToOperatorAndAuditors = do
  (feed, rootView, sublicense, result) <- distributionFixture
  capsule <- submit feed.licensee $ exerciseCmd sublicense Api.License_Distribute with
    source = Api.ByView rootView, clients = [feed.client1, feed.client2]

  -- Neither the operator nor the auditors see the distributed capsule, as a
  -- contract or through either interface.
  None <- queryInterfaceContractId feed.operator capsule
  None <- queryInterfaceContractId feed.auditor1 capsule
  None <- queryInterfaceContractId feed.auditor2 capsule
  operatorCapsules <- query @Capsule feed.operator
  map (\(cid, _) -> toInterfaceContractId @Api.Capsule cid) operatorCapsules === [result.capsule]
  auditorCapsules <- query @Capsule feed.auditor1
  map (\(cid, _) -> toInterfaceContractId @Api.Capsule cid) auditorCapsules === [result.capsule]

  -- The operator does see that the sublicense exists, and who owns it.
  Some sub <- queryInterfaceContractId feed.operator sublicense
  sub.owner === feed.licensee

  -- Clients of one capsule see each other.
  [(_, c)] <- query @Capsule feed.client1
  sort c.observers === sort [feed.client1, feed.client2]
  pure ()

testSublicenseRequiresEntitlement : Script ()
testSublicenseRequiresEntitlement = do
  feed <- setup
  -- Shown the root license, a stranger still cannot sublicense from it.
  Some licenseDisc <- queryDisclosure feed.operator (fromInterfaceContractId @License feed.rootLicense)
  submitMustFailWith (actAs feed.stranger <> disclose licenseDisc) "actor is not a licensee of this license" $
    exerciseCmd feed.rootLicense Api.License_CreateSublicense with
      actor = feed.stranger, licenseType = AVText "x", licensees = []

testSublicenseRequiresOwnerEntitlement : Script ()
testSublicenseRequiresOwnerEntitlement = do
  feed <- setup
  submitMustFailWith (actAs feed.operator) "actor is not a licensee of this license" $
    exerciseCmd feed.rootLicense Api.License_CreateSublicense with
      actor = feed.operator, licenseType = AVText "x", licensees = []

testSublicenseInheritsTerms : Script ()
testSublicenseInheritsTerms = do
  (feed, _, sublicense, _) <- distributionFixture
  Some sublicenseContract <- queryContractId feed.licensee (fromInterfaceContractId @License sublicense)
  -- The parent's terms the child inherits: its owner as licensor, the
  -- operator, the expiry and the delegate; the rest is the child's own.
  sublicenseContract.licensor === feed.operator
  sublicenseContract.operator === feed.operator
  sublicenseContract.validUntil === None
  sublicenseContract.delegate === None
  sublicenseContract.owner === feed.licensee
  sublicenseContract.licensees === [feed.client1]

testSublicenseChainContinues : Script ()
testSublicenseChainContinues = do
  (feed, rootView, sublicense, _) <- distributionFixture
  -- The licensee named client1 as entitled to sublicense; client1 creates a
  -- second-level license and distributes under it to client2. The operator
  -- observes the second-level license too.
  Some sub <- queryInterfaceContractId feed.client1 sublicense
  sub.licensees === [feed.client1]
  subsublicense <- submit feed.client1 $ exerciseCmd sublicense Api.License_CreateSublicense with
    actor = feed.client1, licenseType = AVText "redistribution", licensees = []
  Some _ <- queryInterfaceContractId feed.operator subsublicense
  -- client1 holds a capsule distributed under the first-level license and
  -- redistributes it under its own.
  firstLevel <- submit feed.licensee $ exerciseCmd sublicense Api.License_Distribute with
    source = Api.ByView rootView, clients = [feed.client1]
  Some firstLevelView <- queryInterfaceContractId feed.client1 firstLevel
  secondLevel <- submit feed.client1 $ exerciseCmd subsublicense Api.License_Distribute with
    source = Api.ByView firstLevelView, clients = [feed.client2]
  Some v <- queryInterfaceContractId feed.client2 secondLevel
  v.content.license === subsublicense
  v.content.dataPoint.distributor === feed.client1
  -- client2 was not entitled to sublicense from the second-level license,
  -- even when shown it.
  Some subDisc <- queryDisclosure feed.client1 (fromInterfaceContractId @License subsublicense)
  submitMustFailWith (actAs feed.client2 <> disclose subDisc) "actor is not a licensee of this license" $
    exerciseCmd subsublicense Api.License_CreateSublicense with
      actor = feed.client2, licenseType = AVText "x", licensees = []

testOnlyOwnerDistributes : Script ()
testOnlyOwnerDistributes = do
  (feed, rootView, sublicense, _) <- distributionFixture
  submitMustFail feed.client1 $ exerciseCmd sublicense Api.License_Distribute with
    source = Api.ByView rootView, clients = [feed.client1]
  -- The root license is owned by the operator; the licensee cannot
  -- distribute under it directly.
  submitMustFail feed.licensee $ exerciseCmd feed.rootLicense Api.License_Distribute with
    source = Api.ByView rootView, clients = [feed.client1]

testLicenseRejectsCapsuleOfAnotherDefinition : Script ()
testLicenseRejectsCapsuleOfAnotherDefinition = do
  (feed, rootView, _, _) <- distributionFixture
  (otherDefinition, _) <- bootstrapDefinition feed "ETH/USD" None
  otherRootLicense <- createRootLicense feed.operator [feed.licensee, feed.publisher] otherDefinition
  otherSublicense <- submit feed.licensee $
    exerciseCmd otherRootLicense Api.License_CreateSublicense with
      actor = feed.licensee, licenseType = AVText "redistribution", licensees = []
  submitMustFailWith (actAs feed.licensee) "capsule belongs to another definition" $
    exerciseCmd otherSublicense Api.License_Distribute with
      source = Api.ByView rootView, clients = [feed.client1]

testRevokedLicenseCannotDistribute : Script ()
testRevokedLicenseCannotDistribute = do
  (feed, rootView, sublicense, _) <- distributionFixture
  let subCid = fromInterfaceContractId @License sublicense
  -- A client cannot revoke; the operator can, as observer.
  submitMustFailWith (actAs feed.client1) "only the licensor or the operator may revoke" $
    exerciseCmd subCid License_Revoke with revoker = feed.client1
  submit feed.operator $ exerciseCmd subCid License_Revoke with revoker = feed.operator
  submitMustFail feed.licensee $ exerciseCmd sublicense Api.License_Distribute with
    source = Api.ByView rootView, clients = [feed.client1]
